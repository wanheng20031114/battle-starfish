; Curling 的独立 ENet 转发进程。它不加载 Battle Starfish 主项目。
config_version=5

[application]

config/name="Curling Relay"
run/main_scene="res://relay.tscn"

[display]

window/size/viewport_width=320
window/size/viewport_height=180

[network]

limits/debugger/max_chars_per_second=2048

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

